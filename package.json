{
  "name": "odin-project-members_only",
  "version": "1.0.0",
  "description": "A simple messsaging board for an exclusive club, created as an implementation demonstrating authentication.",
  "keywords": [
    "backend",
    "nodejs",
    "express",
    "ejs",
    "postgres",
    "express-validator",
    "express-session",
    "passportjs",
    "passport-local",
    "pg",
    "pg-format"
  ],
  "license": "ISC",
  "author": "attritionxd-oss",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node ./src/server.js",
    "dev": "node --env-file=.env.development.local --watch ./src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check",
    "test": "jest --watch --testPathIgnorePatterns=\"src/modules/(users|messages|userHistory)\"",
    "test:all": "jest --runInBand --watch",
    "test:db": "jest --runInBand --watch --testPathPatterns=\"src/modules/(users|messages|userHistory)\"",
    "db:schema:test": "node --env-file=.env.test.local src/models/schema.seed.js",
    "db:schema:dev": "node --env-file=.env.development.local src/models/schema.seed.js",
    "db:schema": "node src/models/schema.seed.js",
    "table:seed:dev": "node --env-file=.env.development.local src/models/all.seed.js",
    "table:seed:dev:users": "node --env-file=.env.development.local src/modules/users/users.seed.js",
    "table:seed:dev:messages": "node --env-file=.env.development.local src/modules/messages/messages.seed.js",
    "table:seed": "node src/models/all.seed.js"
  },
  "dependencies": {
    "connect-pg-simple": "^10.0.0",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "pg-format": "^1.0.4",
    "promisify": "^0.0.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "babel-jest": "^30.5.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-ejs": "^1.0.3",
    "prettier-plugin-sql": "^0.20.0"
  },
  "imports": {
    "#*": "./src/*",
    "#config/*": "./src/config/*",
    "#controllers/*": "./src/controllers/*",
    "#middleware/*": "./src/middleware/*",
    "#modules/*": "./src/modules/*",
    "#routes/*": "./src/routes/*",
    "#services/*": "./src/services/*",
    "#models/*.js": "./src/models/*.js",
    "#utils/*": "./src/utils/*",
    "#tests/*": "./tests/*",
    "#sandbox/*": "./sandbox/*"
  }
}
