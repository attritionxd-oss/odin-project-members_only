<nav class="navlinks__wrapper">
  <ul class="navlinks__list">
    <li>
      <a
        class="navlinks__item"
        href="/"
        title="All messages"
        aria-label="View all messages"
      >
        <%- include("../icons/chat-icon") %>
      </a>
    </li>

    <% if (isAuthenticated && isActivated) { %>
    <li>
      <a
        class="navlinks__item"
        href="/new"
        title="New message"
        aria-label="Create new message"
      >
        <%- include("../icons/chat-add-icon.ejs") %>
      </a>
    </li>
    <li>
      <a
        class="navlinks__item"
        href="/messages/user"
        title="View sent messages"
        aria-label="View sent messages"
        ><%- include("../icons/chat-history-icon") %></a
      >
    </li>
    <% if (["ADMIN", "MODERATOR"].includes(locals.currentUser.role)) { %>
    <li>
      <a
        class="navlinks__item"
        href="/users/manage"
        title="Manage users"
        aria-label="Manage site users"
      >
        <%- include("../icons/manage-users-icon.ejs") %>
      </a>
    </li>
    <% } %>
    <% } %>

    <li>
      <%- include("../partials/usermenu") %>
    </li>
  </ul>
</nav>
