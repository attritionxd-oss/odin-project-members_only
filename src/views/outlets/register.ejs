<div class="outlet__outlet-wrapper">
  <div class="outlet__form-wrapper">
    <h2>Sign up</h2>
    <form action="/users/register" method="post" class="outlet__form">
      <p>
        <label>Username</label>
        <input
          type="text"
          name="username"
          id="username"
          value="<%= fields.username %>"
        />
      </p>
      <p>
        <label>First name</label>
        <input
          type="text"
          name="first_name"
          id="first_name"
          value="<%= fields.first_name %>"
        />
      </p>
      <p>
        <label>Last name</label>
        <input
          type="text"
          name="last_name"
          id="last_name"
          value="<%= fields.last_name %>"
        />
      </p>
      <p>
        <label>Password</label>
        <input
          type="password"
          name="password"
          id="password"
          value="<%= fields.password %>"
        />
      </p>
      <button type="submit" class="btn btn-rect btn-tall btn-action-go">
        Sign Up
      </button>
    </form>
    <!-- prettier-ignore -->
    <pre style="font-size: 0.8rem; margin-top: 1rem;"
    >fields: <%= JSON.stringify(fields, null, 2) %></pre>
  </div>
</div>
