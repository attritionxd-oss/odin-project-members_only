<div class="outlet__outlet-wrapper">
  <div class="login__auth-card">
    <h2><%= title %></h2>
    <p>Please log in</p>

    <form action="/login" method="post" class="login__form">
      <input type="hidden" name="redirectTo" value="<%= redirectTo %>" />

      <div class="login__form-group">
        <label for="username">Username</label>
        <input
          type="text"
          name="username"
          id="username"
          class="form-control"
          value="<%= formData.username %>"
        />
      </div>

      <div class="login__form-group">
        <label for="password">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control"
          placeholder="••••••••"
        />
      </div>

      <% if (error) { %>
      <div class="login__error" role="alert">
        <ul class="form-errors">
          <% error.forEach(e => { %>
          <li class="form-error-item"><%= e.msg %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>

      <% if (errorMessage) { %>
      <div class="login__error" role="alert"><%= errorMessage %></div>
      <% } %>

      <button type="submit" class="login__login-btn btn-tall btn-rect">
        Sign In
      </button>
    </form>
  </div>
</div>
