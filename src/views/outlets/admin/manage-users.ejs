<div class="outlet__outlet-wrapper">
  <div>
    <h2><%= title %></h2>
    <h3>All users</h3>
    <% if (users && users.length > 0) { %>

    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th class="col-id">
              <a
                href="<%= getSortUrl('id') %>"
                class="sort-link <%= currentSort === 'id' ? 'active' : '' %>"
                aria-label="ID column header (sort by ID)"
                title="ID column header (sort by ID)"
                >ID<span class="sort-icon"
                  ><%= currentSort === 'id' ? (currentOrder === 'asc' ? '▲' :
                '▼'): '↕' %></span
                >
              </a>
            </th>

            <th class="text-left">
              <a
                href="<%= getSortUrl('username') %>"
                class="sort-link <%= currentSort === 'username' ? 'active' : '' %>"
                aria-label="Username column header (sort by Username)"
                title="Username column header (sort by Username)"
                >Username<span class="sort-icon"
                  ><%= currentSort === 'username' ? (currentOrder === 'asc' ? '▲' :
                '▼'): '↕' %></span
                >
              </a>
            </th>

            <th class="text-left">
              <a
                href="<%= getSortUrl('full_name') %>"
                class="sort-link <%= currentSort === 'full_name' ? 'active' : '' %>"
                aria-label="Full Name column header (sort by Full Name)"
                title="Full Name column header (sort by Full Name)"
                >Name<span class="sort-icon"
                  ><%= currentSort === 'full_name' ? (currentOrder === 'asc' ? '▲' :
                '▼'): '↕' %></span
                >
              </a>
            </th>

            <th class="text-left">
              <a
                href="<%= getSortUrl('status') %>"
                class="sort-link <%= currentSort === 'status' ? 'active' : '' %>"
                aria-label="Status column header (sort by Status)"
                title="Status column header (sort by Status)"
                >status<span class="sort-icon"
                  ><%= currentSort === 'status' ? (currentOrder === 'asc' ? '▲' :
                '▼'): '↕' %></span
                >
              </a>
            </th>

            <th class="text-left">
              <a
                href="<%= getSortUrl('role') %>"
                class="sort-link <%= currentSort === 'role' ? 'active' : '' %>"
                aria-label="Role column header (sort by Role)"
                title="Role column header (sort by Role)"
                >role<span class="sort-icon"
                  ><%= currentSort === 'role' ? (currentOrder === 'asc' ? '▲' :
                '▼'): '↕' %></span
                >
              </a>
            </th>

            <th class="text-left">
              <a
                href="<%= getSortUrl('created') %>"
                class="sort-link <%= currentSort === 'created' ? 'active' : '' %>"
                aria-label="Timestamps column header (sorts by Created date)"
                title="Timestamps column header (sorts by Created date)"
                >timestamps<span class="sort-icon"
                  ><%= currentSort === 'created' ? (currentOrder === 'asc' ? '▲' :
                '▼'): '↕' %></span
                >
              </a>
            </th>

            <% if (currentUser.role === "ADMIN") { %>
            <th class="col-actions">Action</th>
            <% } %>
          </tr>
        </thead>

        <tbody>
          <% users.forEach(user => { %>
          <tr>
            <td class="col-id">
              <a href="/users/<%= user.id %>"><%= user.id %></a>
            </td>
            <td class="text-left">
              <a href="/users/<%= user.id %>"><%= user.username %></a>
            </td>
            <td class="text-left">
              <a href="/users/<%= user.id %>"><%= user.full_name %></a>
            </td>
            <td class="text-left">
              <a href="/users/<%= user.id %>"><%= user.status %></a>
            </td>
            <td class="text-left">
              <a href="/users/<%= user.id %>"><%= user.role %></a>
            </td>
            <td class="text-left">
              <ul
                class="detail-list"
                title="<%= 'Created: ' + user.created_at__formatted + ' \nModified: ' + user.updated_at__formatted + ' \nTerminated: ' + user.deleted_at__formatted %>"
              >
                <li>
                  <span>Created:</span>
                  <span><%= user.created_at__formatted %></span>
                </li>
                <li>
                  <span>Modified:</span>
                  <span><%= user.updated_at__formatted %></span>
                </li>
                <li>
                  <span>Deleted:</span>
                  <span><%= user.deleted_at__formatted %></span>
                </li>
              </ul>
            </td>
            <% if (currentUser.role === "ADMIN") { %>
            <td class="col-actions">
              <div class="actions-group">
                <% if (user.status === "pending activation") { %>
                <form
                  action="/users/<%= user.id %>/activate"
                  method="post"
                  class="inline-form"
                >
                  <button type="submit" class="btn btn-sm btn-action-go">
                    Activate
                  </button>
                </form>
                <% } %>

                <% if (user.deleted_at === null) { %>
                <form
                  action="/users/<%= user.id %>/terminate"
                  method="post"
                  class="inline-form"
                >
                  <button type="submit" class="btn btn-sm btn-action-danger">
                    Terminate
                  </button>
                </form>
                <% } %>

                <% if (user.deleted_at !== null) { %>
                <form
                  action="/users/<%= user.id %>/restore"
                  method="post"
                  class="inline-form"
                >
                  <button type="submit" class="btn btn-sm">Restore</button>
                </form>
                <% } %>
              </div>
            </td>
            <% } %>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <% } else { %>

    <p>No users found.</p>

    <% } %>
  </div>
</div>
