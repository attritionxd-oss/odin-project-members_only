<div class="outlet__outlet-wrapper">
  <div class="outlet__form-wrapper">
    <h2>Sign up</h2>
    <form action="/users/register" method="post" class="outlet__form">
      <p>
        <label>Username</label>
        <input
          type="text"
          name="username"
          id="username"
          value="<%= fields.username %>"
          autofocus="true"
        />
      </p>
      <p>
        <label>First name</label>
        <input
          type="text"
          name="first_name"
          id="first_name"
          value="<%= fields.first_name %>"
        />
      </p>
      <p>
        <label>Last name</label>
        <input
          type="text"
          name="last_name"
          id="last_name"
          value="<%= fields.last_name %>"
        />
      </p>
      <p>
        <label>Password</label>
        <input
          type="password"
          name="password"
          id="password"
          placeholder="••••••••"
        />
      </p>
      <p>
        <label>Confirm password</label>
        <input
          type="password"
          name="confirm_password"
          id="confirm_password"
          placeholder="••••••••"
        />
      </p>
      <button type="submit" class="btn btn-rect btn-tall btn-action-go">
        Sign Up
      </button>

      <% if (error) { %>
      <div class="login__error" role="alert">
        <ul class="form-errors">
          <% error.forEach(e => { %>
          <li class="form-error-item"><%= e.msg %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </form>
  </div>
</div>
