<div class="outlet__outlet-wrapper">
  <div class="outlet__form-wrapper">
    <h2><%= title %></h2>

    <% if (notification) { %>
    <div class="notification" role="alert">
      <ul class="notification-list">
        <% notification.forEach(n => { %>
        <li class="notification-item success"><%= n.msg %></li>
        <% }) %>
      </ul>
    </div>
    <% } %>

    <form action="/users/password" method="post" class="outlet__form">
      <p>
        <label>Current Password</label>
        <input
          type="password"
          name="current_password"
          id="current_password"
          placeholder="••••••••"
        />
      </p>
      <p>
        <label>New Password</label>
        <input
          type="password"
          name="new_password"
          id="new_password"
          placeholder="••••••••"
        />
      </p>
      <p>
        <label>Confirm New password</label>
        <input
          type="password"
          name="confirm_new_password"
          id="confirm_new_password"
          placeholder="••••••••"
        />
      </p>
      <button type="submit" class="btn btn-rect btn-tall btn-action-go">
        Change Password
      </button>

      <% if (error) { %>
      <div class="form-error" role="alert">
        <ul class="form-errors">
          <% error.forEach(e => { %>
          <li class="form-error-item"><%= e.msg %></li>
          <% }) %>
        </ul>
      </div>
      <% } %>
    </form>
  </div>
</div>
